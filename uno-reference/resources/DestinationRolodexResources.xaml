<!-- Seed resources only; not compiled in this handoff. Use your app's actual font resources. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DestinationPageColor">#FFF5F6F2</Color>
    <Color x:Key="DestinationCardColor">#FFFFFFFF</Color>
    <Color x:Key="DestinationInkColor">#FF263633</Color>
    <Color x:Key="DestinationSecondaryColor">#FF707A75</Color>
    <Color x:Key="DestinationAccentColor">#FFE5F5B6</Color>
    <SolidColorBrush x:Key="DestinationPageBrush" Color="{StaticResource DestinationPageColor}" />
    <SolidColorBrush x:Key="DestinationCardBrush" Color="{StaticResource DestinationCardColor}" />
    <SolidColorBrush x:Key="DestinationInkBrush" Color="{StaticResource DestinationInkColor}" />
    <SolidColorBrush x:Key="DestinationSecondaryBrush" Color="{StaticResource DestinationSecondaryColor}" />
    <SolidColorBrush x:Key="DestinationAccentBrush" Color="{StaticResource DestinationAccentColor}" />
    <SolidColorBrush x:Key="DestinationSceneTextBrush" Color="White" />
    <x:Double x:Key="DestinationCardMaxWidth">480</x:Double>
    <x:Double x:Key="DestinationSceneMinHeight">340</x:Double>
    <x:Double x:Key="DestinationDescriptionFontSize">13</x:Double>
    <CornerRadius x:Key="DestinationCardCornerRadius">26</CornerRadius>
    <Thickness x:Key="DestinationDetailPadding">25,23,25,15</Thickness>
</ResourceDictionary>
