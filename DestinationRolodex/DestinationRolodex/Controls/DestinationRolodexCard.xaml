<UserControl x:Class="DestinationRolodex.Controls.DestinationRolodexCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DestinationRolodex.Controls"
             xmlns:utu="using:Uno.Toolkit.UI"
             IsTabStop="False"
             HorizontalAlignment="Stretch"
             AutomationProperties.Name="Destination explorer">
  <!-- xaml-lint: allow card - the card surface is the design itself (brief 02): white sheet, radius 26, three-layer shadow; CardContentControl adds Material chrome and interaction overlays the design does not have. -->
  <Grid x:Name="Root" MaxWidth="{StaticResource RolodexCardMaxWidth}" HorizontalAlignment="Stretch">
    <utu:ShadowContainer x:Name="Shadow" Background="{StaticResource RolodexCardBrushFixed}" CornerRadius="26" HorizontalAlignment="Stretch">
      <utu:ShadowContainer.Shadows>
        <utu:ShadowCollection>
          <utu:Shadow OffsetX="0" OffsetY="0" BlurRadius="0" Spread="1" Color="#FF172E20" Opacity="0.07" />
          <utu:Shadow OffsetX="0" OffsetY="4" BlurRadius="8" Spread="0" Color="#FF163123" Opacity="0.012" />
          <utu:Shadow OffsetX="0" OffsetY="24" BlurRadius="64" Spread="-22" Color="#FF223E33" Opacity="0.21" />
        </utu:ShadowCollection>
      </utu:ShadowContainer.Shadows>
      <Border x:Name="CardBorder" Background="{StaticResource RolodexCardBrushFixed}" CornerRadius="26">
        <Grid x:Name="CardContent">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Scene: clipped photographic region. All pointer input for browsing lands here. -->
          <Grid x:Name="Scene" Height="480" MinHeight="{StaticResource RolodexSceneMinHeight}" Background="{StaticResource RolodexSceneDefaultColorFixed}" CornerRadius="26,26,0,0">
            <Grid.Clip>
              <RectangleGeometry x:Name="SceneClip" Rect="0,0,480,480" />
            </Grid.Clip>
            <Border x:Name="PhotoHost" IsHitTestVisible="False" />
            <Border Background="{StaticResource RolodexWashVerticalBrushFixed}" IsHitTestVisible="False" />
            <Border Background="{StaticResource RolodexWashHorizontalBrushFixed}" IsHitTestVisible="False" />
            <Border x:Name="Readability" Background="{StaticResource RolodexReadabilityBrushFixed}" Margin="0,82,0,58" IsHitTestVisible="False" />

            <!-- Top bar -->
            <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="26,20,20,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" IsHitTestVisible="False">
                <Viewbox Width="18" Height="18"><Path Style="{StaticResource RolodexIconGlobe}" /></Viewbox>
                <StackPanel x:Name="Eyebrow" Orientation="Horizontal" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel x:Name="Counter" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.88" AutomationProperties.AccessibilityView="Raw">
                  <TextBlock x:Name="CounterCurrent" Text="01" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexCounterFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" />
                  <TextBlock Text="/" Margin="5,0" Opacity="0.5" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexCounterFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" />
                  <TextBlock x:Name="CounterTotal" Text="06" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexCounterFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" />
                </StackPanel>
                <Button x:Name="PlayButton" Style="{StaticResource RolodexBareButton}" Width="44" Height="44" AutomationProperties.Name="Play destination tour" Click="OnPlayClick">
                  <Grid Width="42" Height="42">
                    <Ellipse x:Name="PlayRing" Width="42" Height="42" Stroke="{StaticResource RolodexAccentBrushFixed}" StrokeThickness="1" StrokeDashArray="113.1" StrokeDashOffset="113.1" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                      </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="38" Height="38" CornerRadius="19" BorderThickness="1" BorderBrush="{StaticResource RolodexIconButtonBorderBrushFixed}" Background="{StaticResource RolodexIconButtonFillBrushFixed}">
                      <Grid>
                        <Viewbox x:Name="PlayGlyph" Width="16" Height="16"><Path Style="{StaticResource RolodexIconPlay}" /></Viewbox>
                        <Viewbox x:Name="PauseGlyph" Width="16" Height="16" Visibility="Collapsed"><Path Style="{StaticResource RolodexIconPause}" /></Viewbox>
                      </Grid>
                    </Border>
                  </Grid>
                </Button>
              </StackPanel>
            </Grid>

            <StackPanel x:Name="MotionBadge" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="26,70,0,0" Opacity="0.7" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />

            <!-- Loading / failure status (role=status) -->
            <Border x:Name="MediaStatusPill" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="26,72,26,0" Padding="10,6" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource RolodexStatusBorderBrushFixed}" Background="{StaticResource RolodexStatusFillBrushFixed}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexStatusFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" VerticalAlignment="Center" />
                <Button x:Name="RetryButton" Style="{StaticResource RolodexBareButton}" MinWidth="44" MinHeight="32" Height="32" Padding="4,0" Visibility="Collapsed" Click="OnRetryClick" AutomationProperties.Name="Retry loading the photo">
                  <TextBlock Text="Retry" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexStatusFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" TextDecorations="Underline" />
                </Button>
              </StackPanel>
            </Border>

            <local:CountryPicker x:Name="Picker" VerticalAlignment="Top" Margin="0,88,0,0" RenderTransformOrigin="0.5,0.5">
              <local:CountryPicker.RenderTransform>
                <TranslateTransform x:Name="PickerTranslate" />
              </local:CountryPicker.RenderTransform>
            </local:CountryPicker>

            <!-- Look-around title -->
            <StackPanel x:Name="LookTitle" VerticalAlignment="Top" Margin="27,91,27,0" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0,0">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LookTitleTranslate" Y="6" />
              </StackPanel.RenderTransform>
              <TextBlock x:Name="LookCountry" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexLookCountryFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,7,0,0" Opacity="0.77" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexLookSubtitleFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" LineHeight="16.5" TextWrapping="Wrap">
                <Run Text="Drag to explore the photo." /><LineBreak /><Run Text="Scroll or use + / − to zoom." />
              </TextBlock>
            </StackPanel>

            <HyperlinkButton x:Name="CreditLink" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="26,0,0,78" Padding="0" MinHeight="44" Visibility="Collapsed" Foreground="{StaticResource RolodexCreditBrushFixed}" Background="Transparent" AutomationProperties.Name="Photo source">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconExpand}" Stroke="{StaticResource RolodexCreditBrushFixed}" /></Viewbox>
                <TextBlock x:Name="CreditText" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexCreditFontSize}" Foreground="{StaticResource RolodexCreditBrushFixed}" VerticalAlignment="Center" />
              </StackPanel>
            </HyperlinkButton>

            <!-- Scene footer -->
            <Grid x:Name="SceneFooter" VerticalAlignment="Bottom" Margin="24,0,21,21" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="GestureHint" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Opacity="0.82" IsHitTestVisible="False">
                <Viewbox Width="15" Height="15"><Path Style="{StaticResource RolodexIconScroll}" /></Viewbox>
                <StackPanel x:Name="HintText" Orientation="Horizontal" VerticalAlignment="Center" />
              </StackPanel>
              <Border x:Name="CameraControls" CornerRadius="24" Padding="2" BorderThickness="1" BorderBrush="{StaticResource RolodexCameraBorderBrushFixed}" Background="{StaticResource RolodexCameraFillBrushFixed}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Photo view controls">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button x:Name="ZoomOutButton" Style="{StaticResource RolodexBareButton}" MinWidth="33" MinHeight="34" Width="33" Height="34" Click="OnZoomOutClick" AutomationProperties.Name="Zoom out">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconMinus}" /></Viewbox>
                  </Button>
                  <TextBlock x:Name="ZoomValue" Text="1.0×" MinWidth="32" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource RolodexFontRegular}" FontSize="9" Foreground="{StaticResource RolodexSceneTextBrushFixed}" />
                  <Button x:Name="ZoomInButton" Style="{StaticResource RolodexBareButton}" MinWidth="33" MinHeight="34" Width="33" Height="34" Click="OnZoomInClick" AutomationProperties.Name="Zoom in">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconPlus}" /></Viewbox>
                  </Button>
                  <Border Width="1" Background="{StaticResource RolodexCameraDividerBrushFixed}" Margin="3,4,0,4" />
                  <Button x:Name="ResetButton" Style="{StaticResource RolodexBareButton}" MinWidth="33" MinHeight="34" Width="36" Height="34" Click="OnResetClick" AutomationProperties.Name="Reset photo view">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconReset}" /></Viewbox>
                  </Button>
                </StackPanel>
              </Border>
              <Button x:Name="LookButton" Grid.Column="1" Style="{StaticResource RolodexBareButton}" MinHeight="44" Click="OnLookClick" AutomationProperties.Name="Explore this photo">
                <Border MinHeight="40" Padding="13,0" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource RolodexLookToggleBorderBrushFixed}" Background="{StaticResource RolodexLookToggleFillBrushFixed}">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Viewbox x:Name="OrbitGlyph" Width="18" Height="18"><Path Style="{StaticResource RolodexIconOrbit}" /></Viewbox>
                    <Viewbox x:Name="BackGlyph" Width="16" Height="16" Visibility="Collapsed"><Path Style="{StaticResource RolodexIconBack}" /></Viewbox>
                    <TextBlock x:Name="LookLabel" Text="Look around" FontFamily="{StaticResource RolodexFontMedium}" FontSize="{StaticResource RolodexLookToggleFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Button>
            </Grid>
          </Grid>

          <!-- White detail area -->
          <StackPanel x:Name="Detail" Grid.Row="1" Padding="{StaticResource RolodexDetailPadding}">
            <StackPanel x:Name="DetailCopy" RenderTransformOrigin="0,0">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="DetailTranslate" />
              </StackPanel.RenderTransform>
              <Grid Margin="0,0,0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Viewbox Width="15" Height="15"><Path Style="{StaticResource RolodexIconPin}" Stroke="{StaticResource RolodexPinBrushFixed}" /></Viewbox>
                  <TextBlock x:Name="LocationText" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexLocationFontSize}" Foreground="{StaticResource RolodexInkBrushFixed}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="RegionText" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="DescriptionText" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexDescriptionFontSize}" Foreground="{StaticResource RolodexDescriptionBrushFixed}" LineHeight="21.45" TextWrapping="Wrap" MaxWidth="385" HorizontalAlignment="Left" MinHeight="43" />
            </StackPanel>
            <Grid x:Name="DetailBottom" Margin="0,13,0,0" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="Pagination" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" AutomationProperties.Name="Jump to a country" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Style="{StaticResource RolodexBareButton}" Width="44" Height="44" Click="OnPreviousClick" AutomationProperties.Name="Previous country">
                  <Border Width="40" Height="36" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource RolodexNavBorderBrushFixed}">
                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource RolodexIconUp}" Stroke="{StaticResource RolodexNavInkBrushFixed}" /></Viewbox>
                  </Border>
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource RolodexBareButton}" Width="44" Height="44" Click="OnNextClick" AutomationProperties.Name="Next country">
                  <Border Width="40" Height="36" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource RolodexNavBorderBrushFixed}">
                    <Viewbox Width="18" Height="18"><Path Style="{StaticResource RolodexIconDown}" Stroke="{StaticResource RolodexNavInkBrushFixed}" /></Viewbox>
                  </Border>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </utu:ShadowContainer>

    <TextBlock x:Name="EmptyState" Text="Add destinations to start exploring." Visibility="Collapsed" Padding="25,50" TextAlignment="Center" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexEmptyFontSize}" Foreground="{StaticResource RolodexEmptyInkBrushFixed}" />

    <!-- Polite announcement of settled manual changes (screen readers). Kept in the tree, visually hidden. -->
    <TextBlock x:Name="Announcer" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Selected destination" />
  </Grid>
</UserControl>
