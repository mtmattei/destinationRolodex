<UserControl x:Class="DestinationRolodex.Controls.DestinationRolodexCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DestinationRolodex.Controls"
             IsTabStop="False"
             HorizontalAlignment="Stretch"
             AutomationProperties.Name="Destination explorer">
  <!-- xaml-lint: allow card - the postcard itself is the design (Living Postcard brief §2): warm print rim, one photograph behind caption and controls; CardContentControl adds Material chrome and overlays the design does not have. -->
  <Grid x:Name="Root" MaxWidth="{StaticResource RolodexCardMaxWidth}" HorizontalAlignment="Stretch">
    <!-- Destination-tinted ambient shadow (Skia, bleeds 72 past the card) -->
    <Border x:Name="ShadowHost" Margin="-72" IsHitTestVisible="False" />

    <Grid x:Name="CardFrame" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <CompositeTransform x:Name="FrameTransform" />
      </Grid.RenderTransform>
      <!-- Warm print rim -->
      <Border x:Name="Rim" Background="{StaticResource PostcardRimBrushFixed}" CornerRadius="30" Padding="6">
        <Border x:Name="Inner" CornerRadius="24" Background="{StaticResource RolodexSceneDefaultColorFixed}">
          <!-- One photographic scene: photo, scrim and country rows are drawn by the Skia surface; everything below is XAML above it. -->
          <Grid x:Name="Scene" Height="620" MinHeight="400" Background="{StaticResource RolodexSceneDefaultColorFixed}" CornerRadius="24">
            <Grid.Clip>
              <RectangleGeometry x:Name="SceneClip" Rect="0,0,468,620" />
            </Grid.Clip>
            <Border x:Name="PhotoHost" IsHitTestVisible="False" />
            <Border x:Name="InnerHighlight" BorderThickness="1" BorderBrush="{StaticResource PostcardInnerHighlightBrushFixed}" CornerRadius="24" IsHitTestVisible="False" />

            <!-- Top bar: globe + DESTINATIONS, Play/Pause -->
            <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="22,18,16,0">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Border x:Name="GlobeHost" Width="27" Height="27" />
                <StackPanel x:Name="Eyebrow" Orientation="Horizontal" VerticalAlignment="Center" />
              </StackPanel>
              <Button x:Name="PlayButton" Style="{StaticResource RolodexBareButton}" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Play destination tour" Click="OnPlayClick">
                <Grid Width="44" Height="44">
                  <Ellipse x:Name="PlayRing" Width="44" Height="44" Stroke="{StaticResource RolodexAccentBrushFixed}" StrokeThickness="1" StrokeDashArray="138.2" StrokeDashOffset="138.2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Border Width="40" Height="40" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource PostcardCircleBorderBrushFixed}" Background="{StaticResource PostcardCircleFillBrushFixed}">
                    <Grid>
                      <Viewbox x:Name="PlayGlyph" Width="16" Height="16"><Path Style="{StaticResource RolodexIconPlay}" /></Viewbox>
                      <Viewbox x:Name="PauseGlyph" Width="16" Height="16" Visibility="Collapsed"><Path Style="{StaticResource RolodexIconPause}" /></Viewbox>
                    </Grid>
                  </Border>
                </Grid>
              </Button>
            </Grid>

            <!-- Loading / failure status -->
            <Border x:Name="MediaStatusPill" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="22,66,22,0" Padding="10,6" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource RolodexStatusBorderBrushFixed}" Background="{StaticResource RolodexStatusFillBrushFixed}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexStatusFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" VerticalAlignment="Center" />
                <Button x:Name="RetryButton" Style="{StaticResource RolodexBareButton}" MinWidth="44" MinHeight="32" Height="32" Padding="4,0" Visibility="Collapsed" Click="OnRetryClick" AutomationProperties.Name="Retry loading the photo">
                  <TextBlock Text="Retry" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexStatusFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" TextDecorations="Underline" />
                </Button>
              </StackPanel>
            </Border>

            <!-- Semantic picker surface (focus, name, markers); rows are in the Skia scene -->
            <local:CountryPicker x:Name="Picker" VerticalAlignment="Top" Margin="0,120,0,0" />

            <!-- Look-around title -->
            <StackPanel x:Name="LookTitle" VerticalAlignment="Top" Margin="24,84,24,0" Opacity="0" IsHitTestVisible="False">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LookTitleTranslate" Y="6" />
              </StackPanel.RenderTransform>
              <TextBlock x:Name="LookCountry" FontFamily="{StaticResource RolodexFontSemiBold}" FontSize="{StaticResource RolodexLookCountryFontSize}" Foreground="{StaticResource PostcardCountryBrushFixed}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,7,0,0" Opacity="0.77" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexLookSubtitleFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" LineHeight="16.5" TextWrapping="Wrap">
                <Run Text="Drag to explore the photo." /><LineBreak /><Run Text="Scroll or use + / − to zoom." />
              </TextBlock>
            </StackPanel>

            <!-- Scene footer: hint | camera | Look around, kept above the caption -->
            <Grid x:Name="SceneFooter" VerticalAlignment="Bottom" Margin="24,0,18,180" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="GestureHint" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Opacity="0.82" IsHitTestVisible="False">
                <Viewbox Width="15" Height="15"><Path Style="{StaticResource RolodexIconScroll}" /></Viewbox>
                <StackPanel x:Name="HintText" Orientation="Horizontal" VerticalAlignment="Center" />
              </StackPanel>
              <Border x:Name="CameraControls" CornerRadius="24" Padding="2" BorderThickness="1" BorderBrush="{StaticResource RolodexCameraBorderBrushFixed}" Background="{StaticResource RolodexCameraFillBrushFixed}" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Photo view controls">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Button x:Name="ZoomOutButton" Style="{StaticResource RolodexBareButton}" MinWidth="36" MinHeight="36" Width="36" Height="36" Click="OnZoomOutClick" AutomationProperties.Name="Zoom out">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconMinus}" /></Viewbox>
                  </Button>
                  <TextBlock x:Name="ZoomValue" Text="1.0×" MinWidth="32" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource RolodexFontRegular}" FontSize="9" Foreground="{StaticResource RolodexSceneTextBrushFixed}" />
                  <Button x:Name="ZoomInButton" Style="{StaticResource RolodexBareButton}" MinWidth="36" MinHeight="36" Width="36" Height="36" Click="OnZoomInClick" AutomationProperties.Name="Zoom in">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconPlus}" /></Viewbox>
                  </Button>
                  <Border Width="1" Background="{StaticResource RolodexCameraDividerBrushFixed}" Margin="3,4,0,4" />
                  <Button x:Name="ResetButton" Style="{StaticResource RolodexBareButton}" MinWidth="36" MinHeight="36" Width="38" Height="36" Click="OnResetClick" AutomationProperties.Name="Reset photo view">
                    <Viewbox Width="16" Height="16"><Path Style="{StaticResource RolodexIconReset}" /></Viewbox>
                  </Button>
                </StackPanel>
              </Border>
              <Button x:Name="LookButton" Grid.Column="1" Style="{StaticResource RolodexBareButton}" MinHeight="44" Click="OnLookClick" AutomationProperties.Name="Explore this photo">
                <Border MinHeight="40" Padding="13,0" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource PostcardCircleBorderBrushFixed}" Background="{StaticResource PostcardCircleFillBrushFixed}">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Viewbox x:Name="OrbitGlyph" Width="18" Height="18"><Path Style="{StaticResource RolodexIconOrbit}" /></Viewbox>
                    <Viewbox x:Name="BackGlyph" Width="16" Height="16" Visibility="Collapsed"><Path Style="{StaticResource RolodexIconBack}" /></Viewbox>
                    <TextBlock x:Name="LookLabel" Text="Look around" FontFamily="{StaticResource RolodexFontMedium}" FontSize="{StaticResource RolodexLookToggleFontSize}" Foreground="{StaticResource RolodexSceneTextBrushFixed}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Button>
            </Grid>

            <!-- Integrated caption inside the photograph -->
            <StackPanel x:Name="Caption" VerticalAlignment="Bottom" Padding="26,0,26,19" RenderTransformOrigin="0,0">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="CaptionTranslate" />
              </StackPanel.RenderTransform>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LocationText" FontFamily="{StaticResource PostcardSerif}" FontSize="{StaticResource PostcardPlaceFontSize}" Foreground="{StaticResource PostcardCaptionBrushFixed}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="RegionText" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource PostcardDescriptionFontSize}" Foreground="{StaticResource PostcardDescriptionBrushFixed}" LineHeight="20.4" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" />
              <Button x:Name="CreditLink" Style="{StaticResource RolodexBareButton}" HorizontalAlignment="Left" MinHeight="32" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.Name="Photo source">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Viewbox Width="14" Height="14"><Path Style="{StaticResource RolodexIconExpand}" Stroke="{StaticResource RolodexCreditBrushFixed}" /></Viewbox>
                  <TextBlock x:Name="CreditText" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexCreditFontSize}" Foreground="{StaticResource RolodexCreditBrushFixed}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Grid x:Name="CaptionBottom" Margin="0,12,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Pagination" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" AutomationProperties.Name="Jump to a country" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button x:Name="PrevButton" Style="{StaticResource RolodexBareButton}" Width="44" Height="44" Click="OnPreviousClick" AutomationProperties.Name="Previous country">
                    <Border Width="40" Height="40" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource PostcardCircleBorderBrushFixed}" Background="{StaticResource PostcardCircleFillBrushFixed}">
                      <Viewbox Width="18" Height="18"><Path Style="{StaticResource RolodexIconUp}" /></Viewbox>
                    </Border>
                  </Button>
                  <Button x:Name="NextButton" Style="{StaticResource RolodexBareButton}" Width="44" Height="44" Click="OnNextClick" AutomationProperties.Name="Next country">
                    <Border Width="40" Height="40" CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource PostcardCircleBorderBrushFixed}" Background="{StaticResource PostcardCircleFillBrushFixed}">
                      <Viewbox Width="18" Height="18"><Path Style="{StaticResource RolodexIconDown}" /></Viewbox>
                    </Border>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Grid>
        </Border>
      </Border>
    </Grid>

    <TextBlock x:Name="EmptyState" Text="Add destinations to start exploring." Visibility="Collapsed" Padding="25,50" TextAlignment="Center" FontFamily="{StaticResource RolodexFontRegular}" FontSize="{StaticResource RolodexEmptyFontSize}" Foreground="{StaticResource RolodexEmptyInkBrushFixed}" />

    <!-- Polite announcement of settled changes (screen readers). Kept in the tree, visually hidden. -->
    <TextBlock x:Name="Announcer" Width="1" Height="1" Opacity="0.01" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Selected destination" />
  </Grid>
</UserControl>
