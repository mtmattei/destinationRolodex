<UserControl x:Class="DestinationRolodex.Controls.CountryPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="True"
             UseSystemFocusVisuals="False"
             Height="300"
             HorizontalAlignment="Stretch"
             AutomationProperties.Name="Choose a country">
  <!-- The single semantic selection surface: focusable, named, announces the settled value through the card.
       Country rows themselves are drawn by the card's Skia scene (solid ink + photo-in-type), so no duplicate items exist here. -->
  <!-- xaml-lint: allow card - the focus ring is a 1 px keyboard focus indicator, not a card -->
  <Grid x:Name="Window" Background="Transparent">
    <Grid x:Name="MarkerLeft" Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
      <Ellipse x:Name="MarkerHalo" Fill="{StaticResource RolodexMarkerHaloBrushFixed}" />
      <Ellipse x:Name="MarkerDot" Width="7" Height="7" Fill="{StaticResource RolodexAccentBrushFixed}" />
    </Grid>
    <Border x:Name="MarkerRight" Width="12" Height="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,19,0" Background="{StaticResource RolodexMarkerLineBrushFixed}" IsHitTestVisible="False" />
    <Border x:Name="FocusRing" Margin="13,106" BorderThickness="1" BorderBrush="{StaticResource RolodexFocusRingBrushFixed}" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False" />
  </Grid>
</UserControl>
