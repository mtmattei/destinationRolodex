<Application x:Class="DestinationRolodex.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utus="using:Uno.Toolkit.UI.Simple">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utus:SimpleToolkitTheme xmlns:utus="using:Uno.Toolkit.UI.Simple" />
        <!-- Destination Rolodex card tokens, fonts and icons (theme-invariant: ink over photography) -->
        <ResourceDictionary Source="ms-appx:///Styles/DestinationRolodexResources.xaml" />
        <!-- Simple theme lightweight styling for the demo page's lab controls. SimpleSliderThumbStyle sets its Background
             through a ThemeResource setter, which resolves at app scope, so the override must live here (not Page.Resources). -->
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
              <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF6D8B54" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF5B7746" />
              <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#FFB4BDAE" />
              <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF7D9766" />
              <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF6D8B54" />
              <SolidColorBrush x:Key="SliderTrackFill" Color="#FFD3D7DC" />
              <SolidColorBrush x:Key="ToggleSwitchKnobBoundsFill" Color="#FF7D9B61" />
              <SolidColorBrush x:Key="ToggleSwitchKnobBoundsFillPressed" Color="#FF6D8B54" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Default">
              <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF6D8B54" />
              <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF5B7746" />
              <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#FFB4BDAE" />
              <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF7D9766" />
              <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF6D8B54" />
              <SolidColorBrush x:Key="SliderTrackFill" Color="#FFD3D7DC" />
              <SolidColorBrush x:Key="ToggleSwitchKnobBoundsFill" Color="#FF7D9B61" />
              <SolidColorBrush x:Key="ToggleSwitchKnobBoundsFillPressed" Color="#FF6D8B54" />
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
