<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-browserwasm;net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>DestinationRolodex</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.destinationrolodex</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>DestinationRolodex</ApplicationPublisher>
    <!-- Package Description -->
    <Description>DestinationRolodex powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SimpleTheme;
      Toolkit;
      Mvvm;
      SkiaRenderer;
      Skia;
    </UnoFeatures>
  </PropertyGroup>

</Project>
