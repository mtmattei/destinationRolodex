{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:destination-rolodex:graph:1",
  "title": "Destination Rolodex Handoff Graph",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "approvedTransitions",
    "nodes",
    "edges",
    "tokens",
    "states",
    "assets",
    "ownership",
    "assumptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "approvedTransitions": {
      "const": [
        "morph",
        "liquid"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "required": [
              "status",
              "evidence",
              "confidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "proposed"
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type"
        ]
      }
    },
    "tokens": {
      "type": "string"
    },
    "states": {
      "type": "string"
    },
    "assets": {
      "type": "string"
    },
    "ownership": {
      "type": "object"
    },
    "assumptions": {
      "type": "array"
    }
  }
}
